# TruthLens AI Environment Configuration

# Server
PORT=8000
ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Supabase Authentication
# Set your Supabase project credentials for cloud auth and PostgreSQL persistence.
# If omitted, TruthLens operates in local sandbox mode with isolated developer sessions.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Real AI Detection Providers (Optional)
# TruthLens includes genuine native Computer Vision (2D FFT, ELA), Acoustic, and NLP statistical forensics.
# If keys are provided, it also queries Hugging Face neural classifiers and Resemble Detect.
HF_TOKEN=
HUGGINGFACE_API_KEY=
RESEMBLE_API_KEY=

# Max upload limit in Megabytes
MAX_UPLOAD_SIZE_MB=50
